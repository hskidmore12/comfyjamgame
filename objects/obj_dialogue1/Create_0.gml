instance_create_layer(32, 614, "Dialogue", obj_textbox, {
    texts: [
        "Brzt.\nBrzt.",
        "Hey Kiddo!\nI'm calling cause I need to show ya how to run the lodge.",
        "Ya see those stars?\n That's the lodge's rating\nIt can go up or down depending on if ya do ya job right.",
        "That clock let's ya see when ya days almost over.",
		"Since ya getting no customers at the moment.\nThere is only one thing to do.",
		"Deliver Boxes\n The boxes will come in at that desk,\nand they'll have a number telling ya where to go.",
		"1, down below",
		"2 and 3 are to the left",
		"and 4 is up.",
		"Just place the box on the x and ya good to go",
		"But be careful if ya too late on the boxes.\nPeople will cancel and we lose rating.",
		"When a box comes in you'll hear this sound.",
		"That should be everything,\n Oh and don't let the rating drop below 1 star!"
    ], 
	talking: spr_goatse
});
